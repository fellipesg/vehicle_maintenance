APP_NAME=Revisalog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# php artisan serve is single-threaded; AJAX capture queues extra /_debugbar/open requests.
DEBUGBAR_CAPTURE_AJAX=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Neon / Laravel Cloud:
# DB_CONNECTION=pgsql
# DB_HOST=ep-....c-4.us-east-2.aws.neon.tech   # prefer WITHOUT -pooler for Laravel
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=
# DB_SSLMODE=require
# DB_URL=
# If you must use the -pooler host, keep DB_PGBOUNCER=true (auto when host has -pooler).
# App\Database\PostgresConnection binds booleans as true/false (not 0/1) for Neon/Postgres.
# DB_PGBOUNCER=true

SESSION_DRIVER=database
# On Laravel Cloud + Neon pooler, cookie/file avoid sharing the pooled Postgres
# connection with session/cache writes:
# SESSION_DRIVER=cookie
# CACHE_STORE=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Seconds before a reserved job is retried; must exceed the longest job timeout (PDF jobs: 300s).
DB_QUEUE_RETRY_AFTER=330

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@revisalog.com.br
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS=suporte@revisalog.com.br
MAIL_REPLY_TO_ADDRESS="${MAIL_SUPPORT_ADDRESS}"
MAIL_REPLY_TO_NAME="${APP_NAME}"
# Produção (Laravel Cloud): MAIL_MAILER=resend e RESEND_API_KEY=re_...
# RESEND_API_KEY=
# Na máquina: só log. Não usar Mailpit, SMTP local, nem a API key. Não commitar a key.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
AWS_BUCKET=vehicle-maintenance
AWS_ENDPOINT=
AWS_ENDPOINT_URL_S3=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Capas de veículo — use Cloudflare R2 (S3-compatible). Deixe vazio para usar o disco padrão.
# VEHICLE_COVERS_DISK=r2
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=vehicle-maintenance
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# R2_VISIBILITY=public
# R2_USE_PATH_STYLE_ENDPOINT=false

# Benchmark web (login real). Não commitar valor real.
# BENCHMARK_WEB_PASSWORD=
# AWS_PIN_PUBLIC_DNS=auto
# AWS_PUBLIC_IPS=

# Old bucket, only needed while running `php artisan storage:migrate-legacy`.
LEGACY_AWS_ACCESS_KEY_ID=
LEGACY_AWS_SECRET_ACCESS_KEY=
LEGACY_AWS_DEFAULT_REGION=us-east-2
LEGACY_AWS_BUCKET=
LEGACY_AWS_ENDPOINT=

# Vehicle PDF export (async API downloads)
VEHICLE_PDF_EXPORT_TTL_HOURS=24
VEHICLE_PDF_EXPORT_URL_EXPIRY_MINUTES=60

VITE_APP_NAME="${APP_NAME}"

# Firebase Admin (FCM push). Local: storage/app/firebase-service-account.json
# FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
# Laravel Cloud (ephemeral disk): paste base64 of the JSON file:
# FIREBASE_CREDENTIALS_BASE64=
# Alternativa: o JSON inteiro em uma linha (FIREBASE_CREDENTIALS_BASE64 tem prioridade).
# FIREBASE_CREDENTIALS_JSON=

# Login social (Socialite). Callback: {APP_URL}/api/v1/auth/{google|facebook|twitter}/callback
# Passo a passo do Google em OAUTH_SETUP.md. Não commitar client secret.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT_URI=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TWITTER_REDIRECT_URI=

# CORS — comma-separated origins. Empty: * in local, only APP_URL in production.
# Credentials are enabled whenever the list is not *, so never allow broad patterns.
# CORS_ALLOWED_ORIGINS=https://revisalog.com.br,https://vehicle-maintenance-production-l6pnoo.laravel.cloud
# Optional regex patterns (comma-separated). No default pattern in any environment.
# CORS_ALLOWED_ORIGIN_PATTERNS=

# OpenAPI / Swagger docs at /docs/api (Scramble)
API_DOCS_ENABLED=true
# HTTP Basic Auth for /docs/api. Required in production: docs return 404 there when unset.
# Local/testing: open access when empty.
API_DOCS_USERNAME=
API_DOCS_PASSWORD=

# QA: owner revisions with workshop_id get the workshop seal (see maintenances:verify-linked-workshops)
# MAINTENANCE_AUTO_VERIFY_LINKED_WORKSHOP=false

# Lembrete de revisão preventiva (config/maintenance_intervals.php) — valores padrão:
# MAINTENANCE_INTERVAL_KM=10000
# MAINTENANCE_NOTIFY_BEFORE_KM=2000
# MAINTENANCE_AVERAGE_KM_PER_YEAR=13000

# Sentry (https://sentry.io) — exceptions from report() / unhandled errors
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_SEND_DEFAULT_PII=false

# Página /contato — Cloudflare Turnstile. Sem as chaves o captcha fica desligado (honeypot + throttle seguem).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Rodapé: razão social e CNPJ quando a empresa estiver constituída.
# LEGAL_COMPANY_NAME=
# LEGAL_COMPANY_CNPJ=
