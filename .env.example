APP_NAME="Vehicle Maintenance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Neon / Laravel Cloud:
# DB_CONNECTION=pgsql
# DB_HOST=ep-....c-4.us-east-2.aws.neon.tech   # prefer WITHOUT -pooler for Laravel
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=
# DB_SSLMODE=require
# DB_URL=
# If you must use the -pooler host, keep DB_PGBOUNCER=true (auto when host has -pooler).
# App\Database\PostgresConnection binds booleans as true/false (not 0/1) for Neon/Postgres.
# DB_PGBOUNCER=true

SESSION_DRIVER=database
# On Laravel Cloud + Neon pooler, cookie/file avoid sharing the pooled Postgres
# connection with session/cache writes:
# SESSION_DRIVER=cookie
# CACHE_STORE=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Ou use SMTP_* (Gmail/app password, etc). Com MAIL_MAILER=smtp o Laravel lê SMTP_HOST/PORT/USERNAME/PASSWORD.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
AWS_BUCKET=vehicle-maintenance
AWS_ENDPOINT=
AWS_ENDPOINT_URL_S3=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Capas de veículo — use Cloudflare R2 (S3-compatible). Deixe vazio para usar o disco padrão.
# VEHICLE_COVERS_DISK=r2
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=vehicle-maintenance
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# R2_VISIBILITY=public
# R2_USE_PATH_STYLE_ENDPOINT=false

# Benchmark web (login real). Não commitar valor real.
# BENCHMARK_WEB_PASSWORD=
# AWS_PIN_PUBLIC_DNS=auto
# AWS_PUBLIC_IPS=

# Old bucket, only needed while running `php artisan storage:migrate-legacy`.
LEGACY_AWS_ACCESS_KEY_ID=
LEGACY_AWS_SECRET_ACCESS_KEY=
LEGACY_AWS_DEFAULT_REGION=us-east-2
LEGACY_AWS_BUCKET=
LEGACY_AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# Sentry (https://sentry.io) — exceptions from report() / unhandled errors
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_SEND_DEFAULT_PII=false
